{
  "manifest_version": 3,
  "name": "半托管报价计算器",
  "version": "1.0.1",
  "description": "半托管报价计算器",
  "permissions":["sidePanel"],
  "action": {
    "default_title": "点击打开报价计算器"
  },
  "side_panel": {
    "default_path": "sidepanel.html",
    "openPanelOnActionClick": true
  },
  "icons": {
    "16": "./icon.png",
    "48": "./icon.png",
    "128": "./icon.png"
  },
  "background": {
    "service_worker": "js/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/sidepanel.js"],
      "css": ["css/sidepanel.css"],
      "run_at": "document_idle"
    }
  ]
}
